APP_ADDR=:8080

MYSQL_HOST=<mysql-server-host>
MYSQL_PORT=3306
MYSQL_DATABASE=<mysql-database>
MYSQL_USER=<mysql-user>
MYSQL_PASSWORD=<set-a-strong-password>

INIT_ADMIN_EMAIL=admin@zenmind.cc
INIT_ADMIN_PASSWORD=<set-a-strong-admin-password>

COOKIE_NAME=zenmind_session
COOKIE_SECURE=true
SESSION_TTL=24h
TRUSTED_PROXY_CIDRS=172.20.0.0/16
SQLITE_DB_PATH=/data/data.sqlite

GOOGLE_CLIENT_ID=
GOOGLE_DESKTOP_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://www.zenmind.cc/api/auth/google/callback
SSO_BRIDGE_TOKEN=<same-secret-as-website>
DESKTOP_SSO_PROVIDER=first_party
DESKTOP_SSO_TICKET_TTL=2m
SSO_JWT_PRIVATE_KEY_FILE=/configs/secrets/zenmind-sso-jwt-private.pem
SSO_JWT_PRIVATE_KEY_PEM=
SSO_JWT_ISSUER=https://www.zenmind.cc
SSO_JWT_AUDIENCES=market,tunnel,kanban,zenmind-im-server
SSO_JWT_KEY_ID=default
SSO_JWT_TTL=12h
MARKET_JWT_AUDIENCE=market
MARKET_JWT_TTL=90s
AUTH_LOGIN_URL=/login
AUTH_SUCCESS_URL=https://www.zenmind.cc/
AUTH_FAILURE_URL=https://www.zenmind.cc/auth/failure
